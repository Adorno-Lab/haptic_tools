# Doxygen configuration for the project documentation website.
#
# Only the settings that differ from Doxygen's defaults are listed here; any
# tag not set falls back to its default. Run `doxygen -x Doxyfile` to see the
# full effective configuration.
#
# Build locally with:   doxygen
# Output:               build/docs/index.html
#
# The GitHub Actions workflow in .github/workflows/doxygen-pages.yml runs the
# same command and publishes build/docs to GitHub Pages.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "haptic_tools"
PROJECT_BRIEF          = "ROS 2 tools for teleoperation with a haptic device: haptic navigation and pose mapping"
OUTPUT_DIRECTORY       = build
HTML_OUTPUT            = docs

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         haptic_tools_core/README.md \
                         haptic_tools_core/include \
                         haptic_tools_core/src \
                         haptic_navigation/README.md \
                         haptic_navigation/src \
                         haptic_simulator/src \
                         examples/README.md \
                         examples/haptic_navigation_example/README.md \
                         examples/haptic_navigation_example/src \
                         devel/README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
USE_MDFILE_AS_MAINPAGE = ./README.md
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = haptic_tools_core/include

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
