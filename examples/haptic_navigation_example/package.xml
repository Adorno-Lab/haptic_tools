<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>haptic_navigation_example</name>
  <version>0.0.0</version>
  <description>Example of the haptic navigation (haptic_tools_core): a haptic device drives the holonomic base of scenes/haptic_scene.ttt by publishing its twist.</description>
  <maintainer email="juanjose.quirozomana@manchester.ac.uk">Juan Jose Quiroz Omana</maintainer>
  <license>LGPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sas_core</depend>
  <depend>sas_common</depend>
  <depend>sas_msgs</depend>
  <depend>haptic_tools_core</depend>
  <depend>haptic_tools_msgs</depend>
  <!-- haptic_navigation_example_gui. -->
  <build_depend>qt6-base-dev</build_depend>
  <exec_depend>libqt6widgets6</exec_depend>

  <!-- The device: haptic_simulator, or the UDP receiver of the Touch X (udp_receiver_launch.py of haptic_navigation). -->
  <exec_depend>haptic_simulator</exec_depend>
  <exec_depend>haptic_navigation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
